PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
UNIVERSITY_EMAIL_DOMAINS=.ac.in,.edu.in,.edu,.in,.res.in,.org.in,.org,.co.in,.com,.net
REDIS_URL=redis://default:password@host:port
# Copy the URL and credentials from your LiveKit Cloud project for internet viewers.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-project-api-key
LIVEKIT_API_SECRET=replace-with-project-api-secret
LIVE_MAX_PARTICIPANTS=10000
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
